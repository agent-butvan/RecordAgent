# macOS
.DS_Store

# 文档默认不入库；任务模块需求与实施状态作为代码交付契约保留。
docs/*
!docs/任务模块产品需求与操作说明.md
!docs/任务模块实施计划.md

# 运行态与环境配置（防泄露与本地状态隔离）
.env
.env.*
!.env.example
.agentscope/
.butvan-agent/

# Python 缓存
__pycache__/
*.py[cod]
*$py.class

# 本地数据库与日志
*.db
*.sqlite
*.sqlite3
*.log
logs/

# IDE 与编辑器配置
.idea/
*.iws
*.iml
*.ipr

# 本地工具状态与缓存（不提交）
.codex/
.dsh-plugins/
.impeccable/critique/
.impeccable/review/
.impeccable/config.local.json

# 后端启动器构建产物
scripts/backend-launcher/target/
